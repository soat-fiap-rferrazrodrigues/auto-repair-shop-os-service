PORT=3001

# PostgreSQL (dedicated instance — never shared with os-service)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=billing
DATABASE_SSL=false
DATABASE_MIGRATIONS_RUN=false

# Mercado Pago (use TEST- credentials in homolog)
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=https://billing.example.com/payments/webhook
MP_API_URL=https://api.mercadopago.com

# Messaging (empty = log only / no consumer)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
BILLING_SNS_TOPIC_ARN=
BILLING_SQS_QUEUE_URL=

# Same HS256 secret as os-service / auth lambda (ADR-001). Empty = every
# protected route returns 401.
JWT_SECRET=
